# /etc/systemd/system/consola-informe.service
# Informe diario por correo de la Consola Central (Paso 12).
[Unit]
Description=Consola Central - informe diario
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=consola
Group=consola
WorkingDirectory=/var/www/html/consola-central
Environment=COMPOSER_HOME=/var/lib/consola/.composer
ExecStart=/usr/bin/php /var/www/html/consola-central/artisan consola:informe-diario --no-ansi
TimeoutStartSec=30min
Nice=10
